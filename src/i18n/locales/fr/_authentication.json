{
  "createAccount": {
    "title": "@:app.actions.createAccount",
    "name": {
      "label": "Nom",
      "first": {
        "label": "Prénom",
        "placeholder": "Jeanne"
      },
      "last": {
        "label": "Nom de famille",
        "placeholder": "Dupont"
      }
    },
    "email": {
      "label": "Adresse e-mail",
      "placeholder": "Saisissez votre adresse e-mail"
    },
    "password": {
      "label": "Mot de passe",
      "placeholder": "Saisissez au moins 8 caractères",
      "validation": {
        "label": "Les mots de passe doivent contenir de 8 à 16 caractères et inclure les éléments suivants :",
        "contains": {
          "1": "Au moins un chiffre de 1 à 9 (0 inclus)",
          "2": "Au moins une lettre minuscule",
          "3": "Au moins une lettre majuscule",
          "4": "Au moins un caractère spécial"
        }
      }
    },
    "legal": {
      "base": "En cliquant sur {0}, vous acceptez nos {1} et reconnaissez que notre {2} s’applique.",
      "terms": "@:app.routes.terms",
      "privacy": "@:app.routes.privacy"
    },
    "actions": {
      "createAccount": "@:auth.createAccount.title"
    },
    "success": "Compte créé avec succès. Bienvenue."
  },
  "signIn": {
    "title": "@:app.actions.signIn",
    "email": {
      "label": "@:auth.createAccount.email.label",
      "placeholder": "@:auth.createAccount.email.placeholder"
    },
    "password": {
      "label": "@:auth.createAccount.password.label",
      "placeholder": "@:confirmation.passwordVerification.placeholder",
      "forgot": "Mot de passe oublié?"
    },
    "remember": "Se souvenir de moi",
    "actions": {
      "createAccount": "@:auth.createAccount.actions.createAccount",
      "submit": "@:auth.signIn.title"
    },
    "success": "Connexion réussie. Bon retour."
  },
  "signOut": {
    "title": "@:app.actions.signOut",
    "description": "Vous devrez vous reconnecter pour accéder à votre compte. Êtes-vous sûr de vouloir vous déconnecter?",
    "actions": {
      "cancel": "@:common.cancel",
      "submit": "@:auth.signOut.title"
    },
    "success": "Session terminée avec succès. À la prochaine."
  },
  "confirmEmail": {
    "success": {
      "eyebrow": "E-mail confirmé",
      "title": "Votre adresse e-mail a été vérifiée.",
      "message": "Vous pouvez maintenant continuer à utiliser votre compte."
    },
    "error": {
      "eyebrow": "Échec de la vérification",
      "title": "Nous n’avons pas pu vérifier votre adresse e-mail.",
      "message": "Le lien de vérification est peut-être invalide ou expiré. Veuillez en demander un nouveau et réessayer."
    },
    "actions": {
      "backToHome": "Retour à l’accueil",
      "requestNewEmail": "Demander un nouvel e-mail"
    }
  }
}
