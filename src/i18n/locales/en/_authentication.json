{
  "createAccount": {
    "title": "@:app.actions.createAccount",
    "name": {
      "label": "Name",
      "first": {
        "label": "Given name",
        "placeholder": "Jane"
      },
      "last": {
        "label": "Family name",
        "placeholder": "Doe"
      }
    },
    "email": {
      "label": "Email address",
      "placeholder": "Enter your email address"
    },
    "password": {
      "label": "Password",
      "placeholder": "Enter at least 8 characters",
      "validation": {
        "label": "Passwords must be 8 to 16 characters long and contain the following:",
        "contains": {
          "1": "At least one digit from 1 to 9 (including 0)",
          "2": "At least one lowercase letter",
          "3": "At least one uppercase letter",
          "4": "At least one special character"
        }
      }
    },
    "legal": {
      "base": "By clicking {0}, you are agreeing to our {1} and are acknowledging our {2} applies.",
      "terms": "@:app.routes.terms",
      "privacy": "@:app.routes.privacy"
    },
    "actions": {
      "createAccount": "@:auth.createAccount.title"
    },
    "success": "Account created successfully. Welcome aboard."
  },
  "signIn": {
    "title": "@:app.actions.signIn",
    "email": {
      "label": "@:auth.createAccount.email.label",
      "placeholder": "@:auth.createAccount.email.placeholder"
    },
    "password": {
      "label": "@:auth.createAccount.password.label",
      "placeholder": "@:confirmation.passwordVerification.placeholder",
      "forgot": "Forgot password?"
    },
    "remember": "Remember me",
    "actions": {
      "createAccount": "@:auth.createAccount.actions.createAccount",
      "submit": "@:auth.signIn.title"
    },
    "success": "Signed in successfully. Welcome back."
  },
  "signOut": {
    "title": "@:app.actions.signOut",
    "description": "You’ll need to sign in again to access your account. Are you sure you want to sign out?",
    "actions": {
      "cancel": "@:common.cancel",
      "submit": "@:auth.signOut.title"
    },
    "success": "Session ended successfully. Until next time."
  }
}
