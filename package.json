{
  "name": "quickfe-vue3",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/testing/coverage.mjs check",
    "coverage:report": "vitest run --coverage",
    "coverage:check": "node scripts/testing/coverage.mjs check",
    "coverage:baseline": "node scripts/testing/coverage.mjs propose",
    "test:inventory": "node scripts/testing/inventory.mjs",
    "test:api:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "prettier --write --experimental-cli src/",
    "docker:build": "docker build -t quickfe-vue3 .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:status": "docker compose ps",
    "fonts:download": "tsx scripts/download-google-fonts.ts",
    "format:check": "prettier --check src/ test/ scripts/ docs/ security/ .github/ \"*.{json,ts,md,yml,yaml}\"",
    "check": "run-s format:check lint type-check test:ci security:audit test:coverage build-only",
    "test:unit:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=reports/unit-tests.xml && node scripts/testing/coverage.mjs check",
    "test:ci": "node --test scripts/ci/*.test.mjs",
    "security:audit": "node scripts/ci/security-audit.mjs",
    "security:image": "node scripts/ci/image-exposure.mjs"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.11",
    "@lucide/vue": "^1.56.0",
    "axios": "^1.15.0",
    "focus-trap": "^8.0.1",
    "pinia": "^3.0.4",
    "sass-embedded": "^1.97.2",
    "vee-validate": "^4.15.1",
    "vue": "~3.5.44",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tsconfig/node24": "^24.0.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.5.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-playwright": "^2.3.0",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.6.1",
    "jsdom": "^27.2.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "tsx": "^4.23.1",
    "typescript": "~5.9.0",
    "vite": "^7.2.4",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.14",
    "vue-tsc": "^3.1.5"
  }
}
