{
  "extends": "./tsconfig.app.json",
  "include": [
    "test/unit/**/*.ts",
    "test/integration/**/*.ts",
    "test/setup.ts",
    "test/support/**/*.ts",
    "env.d.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",

    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "jsdom"]
  }
}
